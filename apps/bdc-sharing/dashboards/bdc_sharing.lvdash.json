{
  "datasets": [
    {
      "name": "ds_events",
      "displayName": "Activity events",
      "queryLines": [
        "SELECT\n",
        "  event_time,\n",
        "  event_type,\n",
        "  CASE\n",
        "    WHEN event_type IN ('publish_job_succeeded', 'republish_job_succeeded') THEN 'Published'\n",
        "    WHEN event_type IN ('publish_job_failed', 'republish_job_failed', 'publish_grant_failed', 'publish_preflight_failed') THEN 'Failed'\n",
        "    WHEN event_type = 'delete_finalized' THEN 'Unpublished'\n",
        "    ELSE 'Other'\n",
        "  END AS outcome,\n",
        "  CASE\n",
        "    WHEN event_type = 'publish_preflight_failed' THEN 'Stopped by pre-flight'\n",
        "    WHEN event_type = 'publish_grant_failed' THEN 'GRANT on share failed'\n",
        "    WHEN error_code = 'secret_scope_missing' THEN 'Secret scope missing'\n",
        "    WHEN error_code = 'missing_sp_grant' THEN 'App SP missing table access'\n",
        "    WHEN error_code = 'privilege_denied' THEN 'Privilege denied'\n",
        "    WHEN error_code = 'pk_missing' THEN 'Primary key missing'\n",
        "    WHEN error_code = 'object_not_found' THEN 'Object not found'\n",
        "    ELSE 'Other'\n",
        "  END AS failure_reason,\n",
        "  user_email,\n",
        "  share_name,\n",
        "  recipient_name AS bdc_connection,\n",
        "  run_id,\n",
        "  error_message,\n",
        "  CASE WHEN event_type IN ('publish_job_succeeded', 'republish_job_succeeded', 'publish_job_failed', 'republish_job_failed', 'publish_grant_failed') THEN 1 ELSE 0 END AS is_publish_attempt,\n",
        "  CASE WHEN event_type IN ('publish_job_succeeded', 'republish_job_succeeded') THEN 1 ELSE 0 END AS is_publish_ok\n",
        "FROM activity\n",
        "WHERE event_type <> 'wizard_adopt_probe'\n"
      ],
      "columns": [
        {
          "displayName": "Publish success rate",
          "description": "Successful publishes / publish attempts",
          "expression": "SUM(`is_publish_ok`) / NULLIF(SUM(`is_publish_attempt`), 0)"
        }
      ]
    },
    {
      "name": "ds_published",
      "displayName": "Shares in BDC",
      "queryLines": [
        "WITH grants AS (\n",
        "  SELECT share_name, recipient_name\n",
        "  FROM system.information_schema.share_recipient_privileges\n",
        "  WHERE privilege_type = 'SELECT' AND recipient_name RLIKE '(?i)bdc.*connect|connect.*bdc'\n",
        "),\n",
        "sources AS (\n",
        "  SELECT u.share_name, COUNT(*) AS table_count, MAX(t.last_altered) AS source_last_altered\n",
        "  FROM system.information_schema.table_share_usage u\n",
        "  LEFT JOIN system.information_schema.tables t\n",
        "    ON t.table_catalog = u.catalog_name AND t.table_schema = u.schema_name AND t.table_name = u.table_name\n",
        "  GROUP BY u.share_name\n",
        "),\n",
        "last_pub AS (\n",
        "  SELECT share_name, recipient_name, MAX(event_time) AS last_published, MAX_BY(user_email, event_time) AS last_published_by\n",
        "  FROM activity\n",
        "  WHERE event_type IN ('publish_job_succeeded', 'republish_job_succeeded')\n",
        "  GROUP BY share_name, recipient_name\n",
        ")\n",
        "SELECT\n",
        "  g.share_name,\n",
        "  g.recipient_name AS bdc_connection,\n",
        "  s.share_owner,\n",
        "  COALESCE(src.table_count, 0) AS table_count,\n",
        "  CASE WHEN ROW_NUMBER() OVER (PARTITION BY g.share_name ORDER BY g.recipient_name) = 1 THEN COALESCE(src.table_count, 0) ELSE 0 END AS table_count_once,\n",
        "  src.source_last_altered,\n",
        "  lp.last_published,\n",
        "  lp.last_published_by,\n",
        "  CASE\n",
        "    WHEN lp.last_published IS NULL THEN 'Not published by the app'\n",
        "    WHEN src.source_last_altered > lp.last_published THEN 'Source changed after publish'\n",
        "    ELSE 'Up to date'\n",
        "  END AS schema_status\n",
        "FROM grants g\n",
        "JOIN system.information_schema.shares s ON s.share_name = g.share_name\n",
        "LEFT JOIN sources src ON src.share_name = g.share_name\n",
        "LEFT JOIN last_pub lp ON lp.share_name = g.share_name AND lp.recipient_name = g.recipient_name\n",
        "ORDER BY g.share_name, g.recipient_name\n"
      ]
    },
    {
      "name": "ds_reads",
      "displayName": "SAP reads (audit log)",
      "queryLines": [
        "SELECT\n",
        "  a.event_date,\n",
        "  r.recipient_name AS bdc_connection,\n",
        "  get_json_object(a.response.result, '$.tableName') AS table_name,\n",
        "  COUNT(*) AS queries,\n",
        "  SUM(CAST(get_json_object(a.response.result, '$.numRecords') AS BIGINT)) AS rows_read,\n",
        "  SUM(CAST(get_json_object(a.response.result, '$.scannedAddFileSize') AS BIGINT)) AS bytes_scanned\n",
        "FROM system.access.audit a\n",
        "JOIN system.information_schema.recipients r\n",
        "  ON r.recipient_id = get_json_object(a.response.result, '$.deltaSharingRecipientId')\n",
        "WHERE a.service_name = 'unityCatalog'\n",
        "  AND a.action_name IN ('deltaSharingQueriedTable', 'deltaSharingQueriedTableChanges')\n",
        "  AND a.event_date >= date_sub(current_date(), 180)\n",
        "  AND r.recipient_name RLIKE '(?i)bdc.*connect|connect.*bdc'\n",
        "GROUP BY a.event_date, r.recipient_name, get_json_object(a.response.result, '$.tableName')\n"
      ]
    }
  ],
